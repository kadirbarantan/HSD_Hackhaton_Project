{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Data Source=careerpath.db"
  },
  "Jwt": {
    "Issuer": "CareerPath",
    "Audience": "CareerPath",
    "Key": "",
    "ExpiryDays": 7
  },
  "GitHub": {
    "_comment": "Optional personal access token. Without it GitHub allows 60 imports an hour for the whole server.",
    "Token": ""
  },
  "Ai": {
    "_comment": "Leave ApiKey empty to use the built-in rule-based reviewer. Any OpenAI-compatible endpoint works.",
    "ApiKey": "",
    "BaseUrl": "https://api.openai.com/v1/",
    "Model": "gpt-4o-mini",
    "TimeoutSeconds": 25
  },
  "Cors": {
    "Origins": [ "http://localhost:5173" ]
  }
}
